COMPOSE_PROJECT_NAME=erp-staging

# Replace the image references with the preloaded release-manifest references.
ERP_STAGING_APP_IMAGE=registry.example.invalid/alnahda-erp@sha256:REPLACE_WITH_APP_IMAGE_DIGEST
ERP_STAGING_DB_IMAGE=postgres@sha256:REPLACE_WITH_POSTGRES_18_IMAGE_DIGEST

ERP_DB_NAME=erp_staging
ERP_DB_USER=erp_staging_migrate
ERP_DB_PASSWORD=REPLACE_WITH_STAGING_MIGRATION_PASSWORD
ERP_WEB_DB_USER=erp_staging_web
ERP_WEB_DB_PASSWORD=REPLACE_WITH_STAGING_RUNTIME_PASSWORD
ERP_DJANGO_SECRET_KEY=REPLACE_WITH_STAGING_DJANGO_SECRET
ERP_WEB_WORKERS=2
ERP_PRINT_MEMORY_LIMIT=1g
ERP_WEB_PORT=8012

# The addresses and certificate paths below are examples for the host Nginx template.
ERP_STAGING_INTERNAL_HOST=staff.staging.example.test
ERP_STAGING_OWNER_HOST=owner.staging.example.test
ERP_STAGING_NGINX_LISTEN=192.0.2.40:443
ERP_STAGING_HTTPS_AUTHORITY_SUFFIX=
ERP_STAGING_TLS_CERT=/etc/nginx/staging-tls/server.crt
ERP_STAGING_TLS_KEY=/etc/nginx/staging-tls/server.key
ERP_STAGING_UPSTREAM=127.0.0.1:8012
